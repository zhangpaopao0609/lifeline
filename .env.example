# === Core ===
CDP_URL=http://127.0.0.1:9222
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
POLL_INTERVAL_MS=500
DEBOUNCE_MS=300
SELECTORS_PATH=./selectors.json
LOG_LEVEL=info

# === Window Titles ===
# Include remote qualifier ([WSL: ...], [SSH: ...]) in window titles.
# Set to false for cleaner window names when you don't need to
# distinguish the same project opened locally and remotely.
# WINDOW_TITLE_QUALIFIER=false

# === Auth providers ===
# Auto-detection order: AUTH_HEADER > AUTH_PASSWORD > loopback→none > password
# (first-boot claim). AUTH_PROVIDER pins one explicitly:
#   trusted-header | password | none
# AUTH_PROVIDER=
# --- trusted-header: gateway injects a username header (CF Access / Authelia /
#     Tailscale / nginx auth_request). Non-loopback binds must also set
#     AUTH_TRUSTED_PROXY=1 (the gateway MUST strip this header from clients).
# AUTH_HEADER=X-Auth-Request-User
# AUTH_TRUSTED_PROXY=1
# --- password: first boot prints a one-time claim code to the console; set the
#     password at /claim. AUTH_PASSWORD presets it instead (automation only —
#     the value is visible in process env). PUBLIC_ORIGIN is the address
#     browsers use (behind a proxy set it, or forward X-Forwarded-Host).
# AUTH_PASSWORD=
# PUBLIC_ORIGIN=
# --- none: single-user, loopback only. Private addresses additionally need
#     AUTH_INSECURE_ALLOW=1; public/all-interface binds never get none.
# AUTH_INSECURE_ALLOW=1

# === Avatars (optional) ===
# Avatar URL template; must contain a {userId} placeholder. The server fills it
# from the signed-in name and sends it to the page (user:info.avatar).
# Unset → the page draws an initial block.
# AUTH_AVATAR_URL=https://cdn.example.com/avatars/{userId}.png

# === Remote Deployment (server / agent split) ===
# Two-process architecture:
#   - Remote (VPS):  MODE=server + SERVER_HOST=0.0.0.0 + a set of AUTH_* config
#                    Browser-facing only; no CDP. Start: npm start
#                    (Agents do NOT use AGENT_TOKEN here: each one carries the
#                     per-user token it got from /cli-setup, so the server can
#                     tell whose machine it is. See src/server/identity-store.ts.)
#   - Local machine: REMOTE_URL + the token from `lifeline setup --server-url <url>`
#                    Thin agent: polls local Cursor via CDP, pushes debounced
#                    state upstream, executes commands downstream. Start: npm run agent
# MODE=server
# SERVER_HOST=127.0.0.1
# SERVER_PORT=18765
# REMOTE_URL=http://your-server:18765
# AGENT_TOKEN=

# === Optional overrides ===
# Read straight from the environment by the server / agent; unset = defaults.
# DATA_DIR=./data          # where the SQLite DB and temp files live (default: ./data)
# LOG_FORMAT=json          # server logs as JSON instead of text
